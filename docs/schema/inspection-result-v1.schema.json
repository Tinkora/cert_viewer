{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinkora.github.io/cert_viewer/schema/inspection-result-v1.schema.json",
  "title": "Cert Viewer Inspection Result v1",
  "description": "The version 1 data contract for a successful certificate inspection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_format",
    "certificates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "input_format": {
      "type": "string",
      "enum": [
        "pem_bundle",
        "der"
      ]
    },
    "certificates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/certificate_inspection"
      }
    }
  },
  "$defs": {
    "certificate_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_index",
        "version",
        "serial_number",
        "subject",
        "issuer",
        "not_before_unix",
        "not_after_unix",
        "date_status",
        "subject_alt_names",
        "key_usage",
        "extended_key_usage",
        "basic_constraints",
        "extensions",
        "public_key",
        "signature_algorithm",
        "fingerprints",
        "is_self_issued"
      ],
      "properties": {
        "input_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "version": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "serial_number": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "subject": {
          "$ref": "#/$defs/distinguished_name"
        },
        "issuer": {
          "$ref": "#/$defs/distinguished_name"
        },
        "not_before_unix": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "not_after_unix": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "date_status": {
          "type": "string",
          "enum": [
            "not_yet_valid",
            "within_stated_dates",
            "expired"
          ]
        },
        "subject_alt_names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/general_name_entry"
          }
        },
        "key_usage": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "digital_signature",
              "content_commitment",
              "key_encipherment",
              "data_encipherment",
              "key_agreement",
              "key_cert_sign",
              "crl_sign",
              "encipher_only",
              "decipher_only"
            ]
          }
        },
        "extended_key_usage": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "any",
                  "server_auth",
                  "client_auth",
                  "code_signing",
                  "email_protection",
                  "time_stamping",
                  "ocsp_signing"
                ]
              },
              {
                "$ref": "#/$defs/oid"
              }
            ]
          }
        },
        "basic_constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/basic_constraints_info"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension_summary"
          }
        },
        "public_key": {
          "$ref": "#/$defs/public_key_info"
        },
        "signature_algorithm": {
          "$ref": "#/$defs/algorithm_info"
        },
        "fingerprints": {
          "$ref": "#/$defs/fingerprints"
        },
        "is_self_issued": {
          "type": "boolean"
        }
      }
    },
    "distinguished_name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_name",
        "organization",
        "organizational_unit",
        "country",
        "state",
        "locality",
        "entries"
      ],
      "properties": {
        "common_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "organizational_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "locality": {
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_entry"
          }
        }
      }
    },
    "name_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oid",
        "value",
        "value_format"
      ],
      "properties": {
        "oid": {
          "$ref": "#/$defs/oid"
        },
        "value": {
          "type": "string"
        },
        "value_format": {
          "type": "string",
          "enum": [
            "text",
            "hex"
          ]
        }
      }
    },
    "general_name_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "other_name",
            "email",
            "dns",
            "x400_address",
            "directory_name",
            "edi_party_name",
            "uri",
            "ip",
            "registered_id",
            "invalid"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "basic_constraints_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_ca",
        "path_length_constraint"
      ],
      "properties": {
        "is_ca": {
          "type": "boolean"
        },
        "path_length_constraint": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "extension_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oid",
        "critical",
        "decoded"
      ],
      "properties": {
        "oid": {
          "$ref": "#/$defs/oid"
        },
        "critical": {
          "type": "boolean"
        },
        "decoded": {
          "type": "boolean"
        }
      }
    },
    "algorithm_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oid",
        "display_name"
      ],
      "properties": {
        "oid": {
          "$ref": "#/$defs/oid"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "public_key_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "size_bits"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/algorithm_info"
        },
        "size_bits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sha1"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "oid": {
      "type": "string",
      "pattern": "^(?:(?:0|1)\\.(?:[0-9]|[1-3][0-9])|2\\.(?:0|[1-9][0-9]*))(?:\\.(?:0|[1-9][0-9]*))*$"
    }
  }
}
